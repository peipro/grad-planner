{
  "name": "grad-planner",
  "private": true,
  "version": "1.0.0",
  "description": "研途计划 - 研究生计划与日程管理桌面工具",
  "author": "grad-planner",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "deploy:desktop": "node scripts/deploy.cjs",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:dev": "vite --port 5173 & electron .",
    "dist": "npm run build && electron-builder"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "com.gradplanner.app",
    "productName": "研途计划",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "electron/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "dompurify": "^3.4.13",
    "fast-xml-parser": "^5.10.1",
    "lucide-react": "^0.454.0",
    "lunar-javascript": "^1.7.7",
    "marked": "^18.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.5",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^5.4.10",
    "vitest": "^2.1.9"
  }
}
